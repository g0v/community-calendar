---
// 編輯頁與新增活動頁共用的表單。送出時不直接改資料：組好一張 GitHub issue（表單欄位預先填好），
// 由 workflow 轉成 PR、管理員合併後才生效。沒有 GitHub 帳號的人改用 email
import { CONTACT_EMAIL, REPO } from '../lib/data';
import { SERIES } from '../../scripts/facets.mjs';

interface Props {
  mode: 'edit' | 'new';
  eventId?: string;
  values?: Record<string, string | null | undefined>;
  label?: string; // issue 標題用
}
const { mode, eventId = '', values = {}, label = '' } = Astro.props;
const v = (k: string) => values[k] ?? '';
const fields: { id: string; label: string; type?: string; hint?: string; wide?: boolean }[] = [
  { id: 'name', label: '活動名稱', wide: true },
  { id: 'date', label: '日期', type: 'date' },
  { id: 'date_end', label: '結束日期', type: 'date', hint: '跨天才填' },
  { id: 'start_time', label: '開始時間', type: 'time' },
  { id: 'end_time', label: '結束時間', type: 'time' },
  { id: 'venue', label: '地點', hint: '場地名稱；線上活動寫「線上」' },
  { id: 'address', label: '地址' },
  { id: 'host', label: '主辦' },
  { id: 'signup_url', label: '報名網址', type: 'url' },
  { id: 'online_url', label: '線上參加網址', type: 'url', hint: '直播或線上會議' },
  { id: 'notes_url', label: '共筆網址', type: 'url' },
  { id: 'page_url', label: '活動頁', type: 'url', hint: '官網或 FB 活動頁' },
];
---
<form class="event-form" data-mode={mode} data-event-id={eventId} data-label={label} data-repo={REPO} data-email={CONTACT_EMAIL}>
  <div class="grid">
    {fields.map((f, i) => (<>
      <label class:list={['field', { wide: f.wide }]}>
        <span class="l">{f.label}{(f.id === 'name' || f.id === 'date') && mode === 'new' && <span class="req">必填</span>}</span>
        <input name={f.id} type={f.type ?? 'text'} value={v(f.id)} data-initial={v(f.id)} required={mode === 'new' && (f.id === 'name' || f.id === 'date')} />
        {f.hint && <span class="hint muted">{f.hint}</span>}
      </label>
      {i === 0 && (<>
    <label class="field">
        <span class="l">系列</span>
        <select name="series" data-initial={v('series')}>
          <option value="" selected={!v('series')}>{mode === 'new' ? '不屬於任何系列' : '（沒有系列）'}</option>
          {SERIES.map(([slug, name]) => <option value={slug} selected={v('series') === slug}>{name}</option>)}
        </select>
        <span class="hint muted">只有揪松自己辦的系列</span>
      </label>
      <label class="field">
        <span class="l">揪松主辦</span>
        <select name="jothon" data-initial={v('jothon')}>
          <option value="" selected={!v('jothon')}>{mode === 'new' ? '不確定' : '（未確認）'}</option>
          <option value="是" selected={v('jothon') === '是'}>是</option>
          <option value="不是" selected={v('jothon') === '不是'}>不是</option>
        </select>
        <span class="hint muted">是的話會進揪松團日曆；不屬於上面幾個系列的，系列選「其他揪松活動」</span>
      </label>
        </>)}
    </>))}
    {mode === 'new' && (
      <label class="field wide">
        <span class="l">活動說明</span>
        <textarea name="description" rows="4"></textarea>
      </label>
    )}
    {mode === 'edit' && (
      <label class="field wide check">
        <input type="checkbox" name="takedown" />
        <span>請從行事曆上拿掉這場活動（活動取消、重複、或內容不適合放在這裡）</span>
      </label>
    )}
    <label class="field wide">
      <span class="l">{mode === 'edit' ? '為什麼要改' : '你跟這場活動的關係'}<span class="req">必填</span></span>
      <textarea name="reason" rows="3" required placeholder={mode === 'edit' ? '例如「主辦單位公告改期」，附上來源連結更好' : '例如「我是主辦」「在某某社群看到公告」，附上連結更好'}></textarea>
    </label>
  </div>

  <p class="err" data-err hidden></p>
  <div class="actions">
    <button class="btn primary" type="submit">到 GitHub 送出</button>
    <a class="btn" href="#" data-mail>沒有 GitHub 帳號？寄信給揪松團</a>
  </div>
  <p class="muted small">
    「到 GitHub 送出」會打開一張填好的 issue，按下 Submit 之後會自動開 PR，管理員看過後合併就生效。
    需要 <a href="https://github.com/signup">GitHub 帳號</a>（免費）。不想註冊的話，寄信也可以：信會幫你寫好，揪松團收到後點信裡的連結就能代你送出。
  </p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.event-form')) {
    const mode = form.dataset.mode!;
    const err = form.querySelector<HTMLElement>('[data-err]')!;
    // 編輯：只送有改的欄位，管理員一眼就看得出改了什麼
    const collect = () => {
      const out: Record<string, string> = {};
      form.querySelectorAll<HTMLInputElement>('input[name]:not([type=checkbox]), textarea[name], select[name]').forEach((el) => {
        const v = el.value.trim();
        if (el.name === 'reason' || el.name === 'description') { if (v) out[el.name] = v; return; }
        if (mode === 'new' ? v : v !== (el.dataset.initial ?? '')) {
          // 系列改成「沒有系列」要明確送 none，不然空白會被當成「沒填」
          out[el.name] = !v && el.name === 'series' ? 'none' : v;
        }
      });
      return out;
    };
    const takedown = () => !!form.querySelector<HTMLInputElement>('[name=takedown]')?.checked;
    const check = (f: Record<string, string>) => {
      if (!f.reason) return mode === 'edit' ? '請寫一下為什麼要改。' : '請寫一下你跟這場活動的關係。';
      if (mode === 'edit' && Object.keys(f).filter((k) => k !== 'reason').length === 0 && !takedown()) return '沒有改到任何欄位。';
      if (mode === 'new' && (!f.name || !f.date)) return '活動名稱與日期是必填。';
      return null;
    };
    const label = () => form.dataset.label || collect().name || '';

    // 送出用的 issue 網址：欄位都預先填好。寄信時也附上同一個網址，揪松團的人點了就能代為送出
    const issueUrl = (f: Record<string, string>, viaEmail = false) => {
      const q = new URLSearchParams({
        template: mode === 'edit' ? 'edit-event.yml' : 'new-event.yml',
        title: `${mode === 'edit' ? '修改' : '新增'}：${label()}`,
      });
      if (mode === 'edit') { q.set('event_id', form.dataset.eventId!); if (takedown()) q.set('takedown', '請拿掉'); }
      for (const [k, v] of Object.entries(f)) q.set(k, v);
      if (viaEmail) q.set('reason', `（來信轉交）${f.reason ?? ''}`);
      return `${form.dataset.repo}/issues/new?${q}`;
    };

    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const f = collect();
      const problem = check(f);
      err.hidden = !problem; err.textContent = problem ?? '';
      if (problem) return;
      window.open(issueUrl(f), '_blank', 'noopener');
    });

    // 寄信：寫法比照 PR——哪一場、每個欄位從什麼改成什麼、理由——最後附上預先填好的 issue 連結，
    // 揪松團的人看完點一下、按 Submit，就跟寄信的人自己送出一樣會自動開 PR
    form.querySelector<HTMLAnchorElement>('[data-mail]')!.addEventListener('click', (ev) => {
      ev.preventDefault();
      const f = collect();
      const problem = check(f);
      err.hidden = !problem; err.textContent = problem ?? '';
      if (problem) return;
      const names: Record<string, string> = { series: '系列', jothon: '揪松主辦', name: '活動名稱', date: '日期', date_end: '結束日期', start_time: '開始時間', end_time: '結束時間', venue: '地點', address: '地址', host: '主辦', signup_url: '報名網址', online_url: '線上參加網址', notes_url: '共筆網址', page_url: '活動頁', description: '活動說明' };
      const initial = (k: string) => form.querySelector<HTMLInputElement>(`[name="${k}"]`)?.dataset.initial || '（空）';
      const shown = (k: string, v: string) => (k === 'series' ? form.querySelector<HTMLSelectElement>('[name=series]')?.selectedOptions[0]?.textContent ?? v : v || '（空）');
      const fields = Object.entries(f).filter(([k]) => k !== 'reason' && k !== 'description');
      const page = location.href.replace(/edit\/?(\?.*)?$/, '');
      const body = [
        mode === 'edit' ? `我想修改 g0v 社群行事曆上的這場活動：` : '我想在 g0v 社群行事曆上新增一場活動：',
        mode === 'edit' ? `${label()}\n${page}` : label(),
        '',
        ...(takedown() ? ['【請從行事曆上拿掉這場活動】', ''] : []),
        ...(fields.length ? [mode === 'edit' ? '要改的地方（現在 → 改成）：' : '活動資料：'] : []),
        ...fields.map(([k, v]) => mode === 'edit' ? `・${names[k] ?? k}：${initial(k)} → ${shown(k, v)}` : `・${names[k] ?? k}：${shown(k, v)}`),
        ...(f.description ? ['', `活動說明：${f.description}`] : []),
        '',
        `${mode === 'edit' ? '為什麼要改' : '我跟這場活動的關係'}：${f.reason}`,
        '',
        '――――',
        '給揪松團：點下面的連結，GitHub 上的表單已經照這封信填好，確認後按 Submit 就會自動開 PR。',
        issueUrl(f, true),
      ].join('\n');
      location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(`［社群行事曆］${mode === 'edit' ? '修改' : '新增'}：${label()}`)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>

<style>
  .grid { display: grid; gap: 16px; }
  @media (min-width: 640px) { .grid { grid-template-columns: 1fr 1fr; } .wide { grid-column: 1 / -1; } }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .l { font-size: .875rem; font-weight: 600; }
  .req { margin-left: 6px; font-size: .75rem; font-weight: 500; color: var(--accent); }
  input:not([type=checkbox]), textarea, select {
    width: 100%; padding: 9px 12px; border-radius: var(--r-md); border: 1px solid var(--line);
    background: var(--surface); color: var(--text); font: inherit; font-size: .95rem;
  }
  input:focus, textarea:focus, select:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }
  .hint { font-size: .8rem; }
  .check { flex-direction: row; align-items: center; gap: 8px; font-size: .9rem; }
  .err { color: var(--warn); margin: 16px 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .btn {
    display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px; border-radius: var(--r-md);
    border: 1px solid var(--line); background: transparent; color: var(--text); font: inherit; font-size: .9rem;
    text-decoration: none; cursor: pointer;
  }
  .btn:hover { border-color: var(--muted); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .small { font-size: .85rem; margin-top: 12px; max-width: 44rem; }
</style>
