---
import { REPO, SOURCE_URL, href } from '../lib/data';

interface Props { title?: string; description?: string; image?: string }
const { title, description = 'g0v 社群近期活動：黑客松、AI Monday、各地小聚。可訂閱成日曆。', image } = Astro.props;
const fullTitle = title ? `${title}｜g0v 社群行事曆` : 'g0v 社群行事曆';
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // 在畫面出來前套用使用者選過的主題，避免先閃一下另一種顏色
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href('/')}><span class="mark">g0v</span>社群行事曆</a>
        <nav class="nav">
          <a class="nav-link" href={href('/calendar/')}>日曆</a>
          <a class="nav-link" href={href('/#subscribe')}>訂閱</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="切換深色／淺色">
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>活動資料每天從 <a href={SOURCE_URL}>g0v 揪松團的活動共筆</a> 同步一次。共筆開放社群自由填寫，內容未經審核；共筆上被刪掉的活動，這裡仍會保留。</p>
        <p>資料可直接取用：<a href={href('/events.json')}>events.json</a>。每一筆的修改紀錄都在 <a href={REPO}>GitHub</a> 上。</p>
        <p>資料有誤、活動已取消、或內容不適合放在這裡：請 <a href={`${REPO}/issues/new`}>開 issue</a>，管理員會處理。</p>
      </div>
    </footer>
    <script>
      // 切換鈕：以「現在看到的」為準翻轉，存進 localStorage。沒選過的人一直跟著系統
      const root = document.documentElement;
      const dark = matchMedia('(prefers-color-scheme: dark)');
      const current = () => root.dataset.theme ?? (dark.matches ? 'dark' : 'light');
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const label = () => { btn.setAttribute('aria-label', current() === 'dark' ? '切換成淺色' : '切換成深色'); btn.title = btn.getAttribute('aria-label')!; };
      btn.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        label();
      });
      dark.addEventListener('change', label);
      label();
    </script>
  </body>
</html>

<style is:global>
  /*
   * 一個強調色（鈷藍）＋冷灰中性色。圓角規則：容器 16px、內部元件 10px、標籤 6px。
   */
  :root {
    --bg: #f6f6f7;
    --surface: #ffffff;
    --surface-2: #eeeef1;
    --text: #18181b;
    --muted: #5d5d68;
    --line: #e1e1e6;
    --accent: #2f55d4;
    --accent-soft: #e7ecfc;
    --warn: #9a5b00;
    --warn-soft: #fdf1dc;
    --shadow: 0 1px 2px rgb(24 30 60 / .05), 0 8px 24px -12px rgb(24 30 60 / .18);
    --r-lg: 16px;
    --r-md: 10px;
    --r-sm: 6px;
    --font: 'Geist', 'Noto Sans TC', system-ui, -apple-system, 'PingFang TC', 'Microsoft JhengHei', sans-serif;
    --mono: 'Geist Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    color-scheme: light;
  }
  /*
   * 深色：沒選過就跟系統（第一段），選過就看 html 的 data-theme（第二段）。
   * 兩段內容必須一致——CSS 沒辦法讓兩個選擇器共用一組宣告又各自帶條件。
   */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      --bg: #0e0e11;
      --surface: #16161a;
      --surface-2: #1f1f25;
      --text: #ececf0;
      --muted: #a0a0ac;
      --line: #2a2a32;
      --accent: #8ea6ff;
      --accent-soft: #1b2341;
      --warn: #f2b860;
      --warn-soft: #2e2413;
      --shadow: 0 1px 2px rgb(0 0 0 / .3), 0 12px 32px -16px rgb(0 0 0 / .6);
      color-scheme: dark;
    }
  }
  :root[data-theme='dark'] {
    --bg: #0e0e11;
    --surface: #16161a;
    --surface-2: #1f1f25;
    --text: #ececf0;
    --muted: #a0a0ac;
    --line: #2a2a32;
    --accent: #8ea6ff;
    --accent-soft: #1b2341;
    --warn: #f2b860;
    --warn-soft: #2e2413;
    --shadow: 0 1px 2px rgb(0 0 0 / .3), 0 12px 32px -16px rgb(0 0 0 / .6);
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  img { display: block; max-width: 100%; }
  /* 元件常設 display:grid/flex，會蓋過 hidden 屬性；搜尋篩選靠 hidden，所以要明確壓過 */
  [hidden] { display: none !important; }

  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 3px; transition: color .2s, text-decoration-color .2s; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--r-sm); }

  h1, h2, h3 { line-height: 1.3; margin: 0; font-weight: 700; text-wrap: balance; }
  h1 { font-size: clamp(1.75rem, 4.2vw, 2.75rem); letter-spacing: -.02em; }
  h2 { font-size: 1.35rem; letter-spacing: -.01em; }
  h3 { font-size: 1.05rem; font-weight: 600; }
  p { text-wrap: pretty; }

  /* 只設左右：main 也掛 .wrap，用 padding 簡寫會把 main 的上下內距蓋成 0 */
  .wrap { max-width: 1120px; margin: 0 auto; padding-inline: 16px; }
  @media (min-width: 768px) { .wrap { padding-inline: 32px; } }

  .skip { position: absolute; left: 16px; top: -48px; background: var(--accent); color: #fff; padding: 8px 12px; border-radius: var(--r-sm); z-index: 10; }
  .skip:focus { top: 8px; }

  .site-header { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .site-header .wrap { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text); text-decoration: none; letter-spacing: -.01em; }
  .brand .mark { display: inline-grid; place-items: center; min-width: 28px; padding: 0 5px; height: 28px; border-radius: var(--r-sm); background: var(--accent); color: #fff; font: 600 .8rem/1 var(--mono); }
  .nav { display: flex; align-items: center; gap: 20px; }
  /* 320px 的小手機放不下三個：頁尾也有同一個連結，頁首先藏 */
  @media (max-width: 359px) { .nav .wide-only { display: none; } }
  .theme-toggle {
    display: inline-grid; place-items: center; width: 34px; height: 34px; margin-left: -6px; padding: 0;
    border: 1px solid var(--line); border-radius: var(--r-md); background: transparent; color: var(--muted); cursor: pointer;
  }
  .theme-toggle:hover { color: var(--text); border-color: var(--muted); }
  .theme-toggle svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  /* 深色時顯示太陽（按了變淺色），淺色時顯示月亮。判斷條件跟上面的深色 tokens 一致 */
  .theme-toggle .sun { display: none; }
  :root[data-theme='dark'] .theme-toggle .sun { display: block; }
  :root[data-theme='dark'] .theme-toggle .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .theme-toggle .sun { display: block; }
    :root:not([data-theme='light']) .theme-toggle .moon { display: none; }
  }
  .nav-link { color: var(--muted); text-decoration: none; font-size: .9rem; }
  .nav-link:hover { color: var(--text); }

  main { padding-top: 40px; padding-bottom: 80px; }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: .875rem; padding: 24px 0 40px; }
  .site-footer p { margin: 4px 0; }
  .site-footer a { color: var(--muted); }
  .site-footer a:hover { color: var(--text); }

  /* 共用小元件 */
  .muted { color: var(--muted); }
  .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  /* 數字＋中文單位（25 分鐘）用這個：等寬字體沒有中文，會退回別的字體、字距不齊 */
  .num { font-variant-numeric: tabular-nums; }
  /* 內頁標題比首頁小一級 */
  .page-title { font-size: clamp(1.6rem, 3.2vw, 2.25rem); }
  .badge {
    display: inline-flex; align-items: center; gap: 4px; padding: 1px 7px; border-radius: var(--r-sm);
    background: var(--surface-2); color: var(--muted); font-size: .75rem; font-weight: 500; line-height: 1.6; white-space: nowrap;
  }
  .badge.accent { background: var(--accent-soft); color: var(--accent); }
  .badge.warn { background: var(--warn-soft); color: var(--warn); }
  .back { display: inline-flex; gap: 6px; color: var(--muted); text-decoration: none; font-size: .9rem; margin-bottom: 20px; }
  .back:hover { color: var(--text); }
  .panel { background: var(--surface); border-radius: var(--r-lg); box-shadow: var(--shadow); }

  /* 影片縮圖：YouTube 的 hqdefault 是 4:3 加黑邊，裁成 16:9 */
  .thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--r-md); background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  a:hover .thumb img { transform: scale(1.03); }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
  }
</style>
