---
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import { formatWhen, getEvents, href, isPast, tentative, today, vanishedEarly, type Event } from '../lib/data';

const events = (await getEvents()).filter((e) => !e.hidden);
// 「真的會辦」的：日期確定、沒停辦、不是邀約中的空場次、不是活動日前就從共筆消失的舊計畫
const real = (e: Event) => e.date_precision === 'day' && !e.cancelled && !tentative(e) && !vanishedEarly(e);
const upcoming = events.filter((e) => !isPast(e) && real(e));
const next = upcoming.find((e) => e.jothon);

const in14 = new Date(Date.parse(`${today}T00:00:00Z`) + 14 * 864e5).toISOString().slice(0, 10);
const soon = upcoming.filter((e) => e !== next && e.date_start! <= in14).slice(0, 8);
const soonOrNext = soon.length ? soon : upcoming.filter((e) => e !== next).slice(0, 5); // 兩週內沒有活動時，列接下來的幾場

const years = events.filter((e) => e.date_start).map((e) => e.date_start!.slice(0, 4)).sort();
const stats = {
  total: events.filter((e) => isPast(e) && real(e)).length,
  series: new Set(events.map((e) => e.series).filter(Boolean)).size,
  since: years[0],
};
---
<Base>
  <script is:inline>
    // 舊網址相容：首頁以前就是活動列表，帶著篩選條件分享出去的連結轉到 /events/
    if (/[?&](q|when|jothon|series|city)=/.test(location.search)) location.replace('events/' + location.search);
  </script>

  <section class="hero">
    <h1>g0v 社群行事曆</h1>
    <p class="lede">黑客松、AI Monday、各地小聚與講座，g0v 社群的活動都在這裡。可以訂閱到你的日曆，有異動會自動更新。</p>
  </section>

  {next && (
    <section class="next panel">
      <span class="label">下一場揪松活動</span>
      <h2><a href={href(`/events/${next.id}/`)}>{next.title}</a></h2>
      <p class="when mono">{formatWhen(next)}</p>
      {next.venue && <p class="muted">{next.venue}</p>}
      {next.sub_sessions.length > 0 && <p class="muted">{next.sub_sessions.map((s) => s.name).join('・')}</p>}
      <div class="actions">
        {next.signup_url && <a class="btn primary" href={next.signup_url}>報名</a>}
        <a class="btn" href={href(`/events/${next.id}/`)}>活動資訊</a>
      </div>
    </section>
  )}

  <section class="soon">
    <div class="head">
      <h2>{soon.length ? '近兩週' : '接下來'}</h2>
      <a href={href('/events/')}>看全部活動 →</a>
    </div>
    {soonOrNext.length ? soonOrNext.map((e) => <EventRow event={e} />) : <p class="muted">目前沒有排定的活動。</p>}
  </section>

  <nav class="doors" aria-label="主要功能">
    <a class="panel door" href={href('/calendar/')}>
      <span class="t">日曆</span>
      <span class="muted">一個月一個月看，可以跳到任何一個月</span>
    </a>
    <a class="panel door" href={href('/events/')}>
      <span class="t">搜尋活動</span>
      <span class="muted">依名稱、地點、講者、系列找，含過去的活動</span>
    </a>
    <a class="panel door" href={href('/subscribe/')}>
      <span class="t">訂閱</span>
      <span class="muted">揪松團活動、所有社群活動，或只訂某個系列</span>
    </a>
  </nav>

  <p class="stats muted">
    已收錄 <span class="num">{stats.total}</span> 場辦過的活動、<span class="num">{stats.series}</span> 個系列，最早從 <span class="num">{stats.since}</span> 年開始。
  </p>
</Base>

<style>
  .hero { max-width: 44rem; }
  .lede { font-size: 1.1rem; color: var(--muted); margin: 14px 0 0; }

  .next { margin-top: 40px; padding: 28px; }
  @media (min-width: 768px) { .next { padding: 36px; } }
  .label { display: inline-block; font-size: .8rem; font-weight: 600; color: var(--accent); margin-bottom: 8px; }
  .next h2 { font-size: clamp(1.35rem, 3vw, 1.75rem); overflow-wrap: anywhere; }
  .next h2 a { color: var(--text); text-decoration: none; }
  .next h2 a:hover { color: var(--accent); }
  .next .when { font-size: 1.05rem; margin: 12px 0 4px; }
  .next p { margin: 2px 0; overflow-wrap: anywhere; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .btn {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: var(--r-md);
    border: 1px solid var(--line); color: var(--text); font-size: .9rem; text-decoration: none;
  }
  .btn:hover { border-color: var(--muted); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }

  .soon { margin-top: 56px; }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .head a { font-size: .9rem; text-decoration: none; }

  .doors { display: grid; gap: 12px; margin-top: 56px; }
  @media (min-width: 768px) { .doors { grid-template-columns: repeat(3, 1fr); } }
  .door { display: flex; flex-direction: column; gap: 4px; padding: 20px; text-decoration: none; color: var(--text); transition: transform .2s; }
  .door:hover { transform: translateY(-2px); }
  .door .t { font-weight: 600; font-size: 1.05rem; }
  .door .muted { font-size: .875rem; }

  .stats { margin-top: 40px; font-size: .875rem; }
</style>
