---
import Base from '../../layouts/Base.astro';
import { editUrl, formatWhen, fromAiMonday, getEvents, historyOf, href, SOURCE_URL, tentative, vanishedEarly, type Event } from '../../lib/data';

// 下架的不產生頁面（網址會變成 404）
export async function getStaticPaths() {
  return (await getEvents()).filter((e) => !e.hidden).map((e) => ({ params: { id: e.id }, props: { event: e } }));
}
const { event: e } = Astro.props as { event: Event };

const log = historyOf(e.id);
// 目前套用的修正（overrides）：讓人看得出網站上的值哪些不是來自共筆
const NAMES: Record<string, string> = { title: '活動名稱', date_start: '日期', date_end: '結束日期', start_time: '開始時間', end_time: '結束時間', venue: '地點', address: '地址', host: '主辦', signup_url: '報名網址', online_url: '線上參加網址', notes_url: '共筆網址', page_url: '活動頁' };
const o = e.override ?? {};
const fixes = [
  ...(o.hidden ? ['已下架'] : []),
  ...('series' in o ? [`系列 → ${e.series_label ?? '沒有系列'}`] : []),
  ...(typeof o.jothon === 'boolean' ? [`揪松主辦 → ${o.jothon ? '是' : '不是'}`] : []),
  ...Object.entries(o.set ?? {}).map(([k, v]) => `${NAMES[k] ?? k} → ${v}`),
];
const info = [
  ['系列', e.series_label],
  ['地點', e.venue],
  ['地址', e.address],
  ['主辦', e.host],
].filter(([, v]) => v) as [string, string][];
const links = [
  ['報名', e.signup_url],
  ['線上參加', e.online_url],
  ['共筆', e.notes_url],
  ['活動頁', e.page_url],
].filter(([, v]) => v) as [string, string][];
const other = e.links.filter((u) => !links.some(([, v]) => v === u));
---
<Base title={e.title} description={`${formatWhen(e)}｜${e.venue ?? ''}`}>
  <a class="back" href={href('/events/')}>← 所有活動</a>
  <div class="badges">
    {e.jothon && <span class="badge accent">揪松主辦</span>}
    {e.cancelled && <span class="badge warn">停辦</span>}
    {vanishedEarly(e) && <span class="badge warn">共筆已移除</span>}
  </div>
  <h1 class="page-title">{e.title}</h1>
  <p class="when mono">{tentative(e) ? `${e.date_start}・講者邀約中，時間未定` : formatWhen(e)}</p>

  {e.cancelled && <p class="notice">這場活動已停辦。</p>}

  {vanishedEarly(e) && (
    <p class="notice">這場活動在 {e.removed_from_source} 從揪松團的活動共筆上被移除了，活動日還沒到。可能已經取消，參加前請向主辦單位確認。</p>
  )}

  <div class="grid">
    <div>
      {info.length > 0 && (
        <dl class="info">
          {info.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
        </dl>
      )}
      {(e.talks?.length ?? 0) > 0 && (
        <section>
          <h2>講題</h2>
          <ul class="subs">
            {e.talks!.map((t) => (
              <li><a href={t.url}>{t.title ?? '講題待定'}</a>{t.speakers.length > 0 && <span class="muted">　{t.speakers.join('、')}</span>}</li>
            ))}
          </ul>
        </section>
      )}
      {e.aimonday_url && <p class="am"><a href={e.aimonday_url}>在 AI Monday 看講題、錄影與簡報 →</a></p>}
      {e.sub_sessions.length > 0 && (
        <section>
          <h2>場次</h2>
          <ul class="subs">
            {e.sub_sessions.map((s) => (
              <li><strong>{s.name}</strong> <span class="mono muted">{s.date}{s.start_time && ` ${s.start_time}${s.end_time ? `–${s.end_time}` : ''}`}</span>{s.venue && <div class="muted">{s.venue}</div>}</li>
            ))}
          </ul>
        </section>
      )}
      {(links.length > 0 || other.length > 0) && (
        <section>
          <h2>連結</h2>
          <ul class="links">
            {links.map(([k, v]) => <li>{k}：<a href={v}>{v}</a></li>)}
            {other.map((u) => <li><a href={u}>{u}</a></li>)}
          </ul>
        </section>
      )}
      {e.raw && (
        <section>
          <h2>{e.source === 'hsiaothon' ? '小松果上的原文' : '共筆上的原文'}</h2>
          <pre class="raw">{e.raw}</pre>
        </section>
      )}
      {(log.length > 0 || fixes.length > 0) && (
        <!-- 預設收起來：大部分人只想看活動本身，紀錄是給要確認資料來源的人看的 -->
        <details id="history" class="history">
          <summary>
            這筆資料的紀錄
            <span class="muted count">{log.length} 筆{fixes.length > 0 && `，${fixes.length} 項修正`}</span>
          </summary>
          {fixes.length > 0 && (
            <div class="fixes">
              <p class="fixes-title">目前套用的修正</p>
              <ul>{fixes.map((x) => <li>{x}</li>)}</ul>
            </div>
          )}
          <ol class="log">
            {log.map((h) => (
              <li><span class="d mono">{h.date}</span><span class="badge">{h.kind}</span><a href={h.url}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      )}
    </div>

    <aside class="panel side">
      <h2>這筆資料</h2>
      {fromAiMonday(e) ? (
        <dl class="info small">
          <dt>來源</dt><dd><a href={e.source_url}>AI Monday 工作小組</a></dd>
        </dl>
      ) : e.source === 'hsiaothon' ? (
        <dl class="info small">
          <dt>來源</dt><dd><a href={e.source_url}>小松果</a>（g0v 台北社群空間的使用紀錄）</dd>
          <dt>編號</dt><dd class="mono">{e.hsiaothon!.year} No.{e.hsiaothon!.no}</dd>
        </dl>
      ) : e.source === 'manual' ? (
        <dl class="info small">
          <dt>來源</dt><dd><a href={e.source_url}>從網站新增</a></dd>
        </dl>
      ) : (
        <dl class="info small">
          <dt>來源</dt><dd><a href={SOURCE_URL}>揪松團活動共筆</a></dd>
          <dt>第一次看到</dt><dd class="mono">{e.first_seen}</dd>
          <dt>共筆上</dt><dd>{e.in_source ? '還在' : e.removed_from_source ? `${e.removed_from_source} 前已移除` : '已移除'}</dd>
          {e.hsiaothon && <><dt>小松果</dt><dd><span class="mono">{e.hsiaothon.year} No.{e.hsiaothon.no}</span>{e.hsiaothon.notes_url && <>・<a href={e.hsiaothon.notes_url}>成果共筆</a></>}</dd></>}
        </dl>
      )}
      {e.warnings.length > 0 && (
        <ul class="warnings">{e.warnings.map((w) => <li>{w}</li>)}</ul>
      )}
      <div class="actions">
        <a class="btn" href={href(`/events/${e.id}/edit/`)}>修改這筆</a>
        <details class="tip">
          <summary aria-label="說明">i</summary>
          <p>資料有錯、活動取消、或內容不適合放在這裡，都從「修改這筆」送出，管理員看過後就會更新。管理員也可以直接改<a href={editUrl(e)}>修正檔</a>。</p>
        </details>
        {log.length > 0 && <a class="link" href="#history" data-open-history>修改紀錄</a>}
      </div>
    </aside>
  </div>
</Base>

<script>
  // 側欄的「修改紀錄」：打開收起來的紀錄再捲過去
  document.querySelector('[data-open-history]')?.addEventListener('click', () => {
    const d = document.querySelector<HTMLDetailsElement>('#history');
    if (d) d.open = true;
  });
  if (location.hash === '#history') document.querySelector<HTMLDetailsElement>('#history')?.setAttribute('open', '');
</script>

<style>
  .badges { display: flex; gap: 6px; min-height: 0; margin-bottom: 8px; }
  .page-title { overflow-wrap: anywhere; }
  .when { font-size: 1.05rem; margin: 12px 0 24px; }
  .notice { padding: 12px 16px; border-radius: var(--r-md); background: var(--warn-soft); color: var(--warn); }
  .grid { display: grid; gap: 32px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 300px; align-items: start; } }
  h2 { font-size: 1rem; margin: 28px 0 10px; }
  .info { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
  .info dt { color: var(--muted); }
  .info dd { margin: 0; overflow-wrap: anywhere; }
  .info.small { font-size: .875rem; }
  .subs, .links { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; }
  .links a { overflow-wrap: anywhere; }
  .raw { white-space: pre-wrap; overflow-wrap: anywhere; font: .85rem/1.6 var(--mono); background: var(--surface-2); padding: 16px; border-radius: var(--r-md); margin: 0; }
  .side { padding: 20px; }
  .side h2 { margin-top: 0; }
  .warnings { margin: 16px 0 0; padding-left: 1.2em; font-size: .85rem; color: var(--warn); }
  .actions { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 16px; font-size: .875rem; }
  .btn { display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border-radius: var(--r-md); border: 1px solid var(--line); color: var(--text); text-decoration: none; }
  .btn:hover { border-color: var(--muted); }
  .link { color: var(--muted); }
  .tip summary {
    list-style: none; display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--muted); font: italic 600 .75rem/1 Georgia, serif; cursor: pointer;
  }
  .tip summary::-webkit-details-marker { display: none; }
  .tip[open] summary { color: var(--accent); border-color: var(--accent); }
  .tip p { position: absolute; left: 0; right: 0; top: calc(100% + 8px); z-index: 2; margin: 0; padding: 10px 12px; border-radius: var(--r-md); background: var(--surface-2); font-size: .8rem; color: var(--muted); }
  .history { margin-top: 32px; border-top: 1px solid var(--line); padding-top: 16px; }
  .history summary { cursor: pointer; font-weight: 600; font-size: .95rem; }
  .history summary .count { font-weight: 400; font-size: .85rem; margin-left: 6px; }
  .history[open] summary { margin-bottom: 12px; }
  .fixes { padding: 10px 14px; border-radius: var(--r-md); background: var(--surface-2); margin-bottom: 12px; font-size: .875rem; }
  .fixes-title { margin: 0 0 4px; font-weight: 600; }
  .fixes ul { margin: 0; padding-left: 1.2em; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: .875rem; }
  .log li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
  .log .d { color: var(--muted); font-size: .8rem; }
  .log a { color: var(--text); text-decoration-color: color-mix(in srgb, var(--text) 25%, transparent); overflow-wrap: anywhere; }



  .am { margin: 16px 0 0; }
</style>
