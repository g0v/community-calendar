---
import Base from '../../layouts/Base.astro';
import { editUrl, formatWhen, fromAiMonday, getEvents, historyUrl, href, REPO, reportUrl, SOURCE_URL, tentative, vanishedEarly, type Event } from '../../lib/data';

// 下架的不產生頁面（網址會變成 404）
export async function getStaticPaths() {
  return (await getEvents()).filter((e) => !e.hidden).map((e) => ({ params: { id: e.id }, props: { event: e } }));
}
const { event: e } = Astro.props as { event: Event };

const history = historyUrl(e);
const info = [
  ['系列', e.series_label],
  ['地點', e.venue],
  ['地址', e.address],
  ['主辦', e.host],
].filter(([, v]) => v) as [string, string][];
const links = [
  ['報名', e.signup_url],
  ['線上參加', e.online_url],
  ['共筆', e.notes_url],
  ['活動頁', e.page_url],
].filter(([, v]) => v) as [string, string][];
const other = e.links.filter((u) => !links.some(([, v]) => v === u));
---
<Base title={e.title} description={`${formatWhen(e)}｜${e.venue ?? ''}`}>
  <a class="back" href={href('/events/')}>← 所有活動</a>
  <div class="badges">
    {e.jothon && <span class="badge accent">揪松主辦</span>}
    {e.cancelled && <span class="badge warn">停辦</span>}
    {vanishedEarly(e) && <span class="badge warn">共筆已移除</span>}
  </div>
  <h1 class="page-title">{e.title}</h1>
  <p class="when mono">{tentative(e) ? `${e.date_start}・講者邀約中，時間未定` : formatWhen(e)}</p>

  {e.cancelled && <p class="notice">這場活動已停辦。</p>}

  {vanishedEarly(e) && (
    <p class="notice">這場活動在 {e.removed_from_source} 從揪松團的活動共筆上被移除了，活動日還沒到。可能已經取消，參加前請向主辦單位確認。</p>
  )}

  <div class="grid">
    <div>
      {info.length > 0 && (
        <dl class="info">
          {info.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
        </dl>
      )}
      {(e.talks?.length ?? 0) > 0 && (
        <section>
          <h2>講題</h2>
          <ul class="subs">
            {e.talks!.map((t) => (
              <li><a href={t.url}>{t.title ?? '講題待定'}</a>{t.speakers.length > 0 && <span class="muted">　{t.speakers.join('、')}</span>}</li>
            ))}
          </ul>
        </section>
      )}
      {e.aimonday_url && <p class="am"><a href={e.aimonday_url}>在 AI Monday 看講題、錄影與簡報 →</a></p>}
      {e.sub_sessions.length > 0 && (
        <section>
          <h2>場次</h2>
          <ul class="subs">
            {e.sub_sessions.map((s) => (
              <li><strong>{s.name}</strong> <span class="mono muted">{s.date}{s.start_time && ` ${s.start_time}${s.end_time ? `–${s.end_time}` : ''}`}</span>{s.venue && <div class="muted">{s.venue}</div>}</li>
            ))}
          </ul>
        </section>
      )}
      {(links.length > 0 || other.length > 0) && (
        <section>
          <h2>連結</h2>
          <ul class="links">
            {links.map(([k, v]) => <li>{k}：<a href={v}>{v}</a></li>)}
            {other.map((u) => <li><a href={u}>{u}</a></li>)}
          </ul>
        </section>
      )}
      {e.raw && (
        <section>
          <h2>{e.source === 'hsiaothon' ? '小松果上的原文' : '共筆上的原文'}</h2>
          <pre class="raw">{e.raw}</pre>
        </section>
      )}
    </div>

    <aside class="panel side">
      <h2>這筆資料</h2>
      {fromAiMonday(e) ? (
        <dl class="info small">
          <dt>來源</dt><dd><a href={e.source_url}>AI Monday 工作小組</a></dd>
        </dl>
      ) : e.source === 'hsiaothon' ? (
        <dl class="info small">
          <dt>來源</dt><dd><a href={e.source_url}>小松果</a>（g0v 台北社群空間的使用紀錄）</dd>
          <dt>編號</dt><dd class="mono">{e.hsiaothon!.year} No.{e.hsiaothon!.no}</dd>
        </dl>
      ) : (
        <dl class="info small">
          <dt>來源</dt><dd><a href={SOURCE_URL}>揪松團活動共筆</a></dd>
          <dt>第一次看到</dt><dd class="mono">{e.first_seen}</dd>
          <dt>共筆上</dt><dd>{e.in_source ? '還在' : e.removed_from_source ? `${e.removed_from_source} 前已移除` : '已移除'}</dd>
          {e.hsiaothon && <><dt>小松果</dt><dd><span class="mono">{e.hsiaothon.year} No.{e.hsiaothon.no}</span>{e.hsiaothon.notes_url && <>・<a href={e.hsiaothon.notes_url}>成果共筆</a></>}</dd></>}
        </dl>
      )}
      {e.warnings.length > 0 && (
        <ul class="warnings">{e.warnings.map((w) => <li>{w}</li>)}</ul>
      )}
      <p class="actions">
        <a href={href(`/events/${e.id}/edit/`)}>修改這筆</a>
        {history && <a href={history}>修改紀錄</a>}
        {fromAiMonday(e) ? <a href="https://github.com/g0v/AI-Monday/issues/new">回報問題</a> : <a href={reportUrl(e)}>回報問題</a>}
      </p>
      <p class="muted tiny">資料有錯、活動取消、或內容不適合放在這裡，按「修改這筆」。管理員可以直接改<a href={editUrl(e)}>修正檔</a>。</p>
    </aside>
  </div>
</Base>

<style>
  .badges { display: flex; gap: 6px; min-height: 0; margin-bottom: 8px; }
  .page-title { overflow-wrap: anywhere; }
  .when { font-size: 1.05rem; margin: 12px 0 24px; }
  .notice { padding: 12px 16px; border-radius: var(--r-md); background: var(--warn-soft); color: var(--warn); }
  .grid { display: grid; gap: 32px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 300px; align-items: start; } }
  h2 { font-size: 1rem; margin: 28px 0 10px; }
  .info { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
  .info dt { color: var(--muted); }
  .info dd { margin: 0; overflow-wrap: anywhere; }
  .info.small { font-size: .875rem; }
  .subs, .links { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; }
  .links a { overflow-wrap: anywhere; }
  .raw { white-space: pre-wrap; overflow-wrap: anywhere; font: .85rem/1.6 var(--mono); background: var(--surface-2); padding: 16px; border-radius: var(--r-md); margin: 0; }
  .side { padding: 20px; }
  .side h2 { margin-top: 0; }
  .warnings { margin: 16px 0 0; padding-left: 1.2em; font-size: .85rem; color: var(--warn); }
  .actions { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 16px 0 6px; }
  .tiny code { font-size: .95em; }
  .tiny { font-size: .8rem; margin: 0; }
  .am { margin: 16px 0 0; }
</style>
