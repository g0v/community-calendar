---
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import { getEvents, href, isPast } from '../lib/data';

// 共筆上的過期活動會被清掉，這一頁就是它們留下來的地方
const events = (await getEvents()).filter((e) => !e.hidden && isPast(e)).reverse();
---
<Base title="過去的活動">
  <a class="back" href={href('/')}>← 近期活動</a>
  <h1 class="page-title">過去的活動</h1>
  <p class="muted">從 2026 年 10 月開始累積。共筆上已經刪掉的活動，這裡仍會保留。</p>
  {events.length ? events.map((e) => <EventRow event={e} />) : <p>還沒有。</p>}
</Base>
